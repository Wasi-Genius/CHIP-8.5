<h2>Search TMDb for a movie</h2>

<% flash.each do |key, value| %>
  <% alert_class = key.to_s == 'notice' ? 'success' : key %>
  <div class="alert alert-<%= alert_class %> alert-dismissible fade show" role="alert">
    <%= value %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<%= form_tag search_tmdb_path, method: :get, id: 'tmdb_form' do %>
  <div class="mb-3">
    <label for="movie_title_field" class="form-label">Movie Name</label>
    <%= text_field_tag 'title', params[:title], class: 'form-control', id: 'movie_title_field', placeholder: 'Manhunter' %>
  </div>

  <div class="mb-3">
    <label for="movie_year_field" class="form-label">Release Year (Optional)</label>
    <%= text_field_tag 'release_year', params[:release_year], class: 'form-control', id: 'movie_year_field', placeholder: '1986' %>
  </div>

  <div class="mb-3">
    <label class="form-label">Language</label><br>
    <%= radio_button_tag 'language', 'en', params[:language] == 'en', id: 'language_en' %>
    <label for="language_en">English Only</label>
    <%= radio_button_tag 'language', 'all', params[:language] != 'en', id: 'language_all' %>
    <label for="language_all">All Languages</label>
  </div>

  <%= submit_tag 'Search', id: 'tmdb_submit', class: 'btn btn-primary' %>
<% end %>

<br>
<%= link_to 'Back to movie list', movies_path, class: 'btn btn-secondary' %>

<% if @movies.present? %>
  <hr>
  <h3>Search Results</h3>
  <table class="table table-striped col-md-12" id="search_movies">
    <thead>
      <tr>
        <th>Movie Title</th>
        <th>Rating</th>
        <th>Release Date</th>
        <th>Synopsis</th>
        <th>Add Movie</th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.rating %></td>
          <td><%= movie.release_date %></td>
          <td><%= movie.respond_to?(:overview) ? movie.overview : '' %></td>
          <td>
            <%= form_tag add_movie_path, method: :post do %>
              <%= hidden_field_tag :title, movie.title %>
              <%= hidden_field_tag :release_date, movie.release_date %>
              <%= hidden_field_tag :rating, movie.rating %>
              <% if movie.respond_to?(:overview) %>
                <%= hidden_field_tag :overview, movie.overview %>
              <% end %>
              <%= submit_tag 'Add movie', class: 'btn btn-success btn-sm' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>